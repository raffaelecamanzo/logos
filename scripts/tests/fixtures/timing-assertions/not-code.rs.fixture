// Text that is not code is never read: comments, strings, raw strings and char
// literals that hold a bound, around one scaled site that keeps the walk non-empty.
// assert!(start.elapsed() < Duration::from_secs(1));
/* assert!(start.elapsed() < Duration::from_secs(2)); /* nested */ assert!(start.elapsed() < Duration::from_secs(3)); */
#[test]
fn text_is_not_code() {
    let start = Instant::now();
    let a = "assert!(start.elapsed() < Duration::from_secs(4));";
    let b = r#"assert!(start.elapsed() < "quoted" Duration::from_secs(5));"#;
    let open = '{';
    let quote = '"';
    let lifetime: &'static str = "x";
    assert!(start.elapsed() < crate::perf::scaled_ms(6), "{a}{b}{open}{quote}{lifetime}");
}
