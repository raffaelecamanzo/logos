// The multi-line bound, scaled: the coverage exemption is kept.
#[test]
fn a_stalled_writer_never_blocks_the_caller() {
    let start = Instant::now();
    for _ in 0..10_000 {
        record();
    }
    assert!(
        cfg!(coverage)
            || (start.elapsed()
                <= logos_core::perf::scaled(Duration::from_secs(2))),
        "took {:?}",
        start.elapsed()
    );
}
