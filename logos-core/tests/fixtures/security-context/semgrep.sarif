{
 "version": "2.1.0",
 "$schema": "https://docs.oasis-open.org/sarif/sarif/v2.1.0/os/schemas/sarif-schema-2.1.0.json",
 "runs": [
  {
   "tool": {
    "driver": {
     "name": "Semgrep OSS",
     "semanticVersion": "1.85.0",
     "rules": [
      {
       "id": "rust.lang.security.sqli.formatted-sql-query",
       "name": "rust.lang.security.sqli.formatted-sql-query",
       "defaultConfiguration": {
        "level": "error"
       },
       "shortDescription": {
        "text": "Formatted SQL query"
       },
       "properties": {
        "tags": [
         "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
         "security"
        ]
       }
      },
      {
       "id": "java.lang.security.audit.formatted-sql-string",
       "name": "java.lang.security.audit.formatted-sql-string",
       "defaultConfiguration": {
        "level": "error"
       },
       "shortDescription": {
        "text": "Formatted SQL string"
       },
       "properties": {
        "tags": [
         "CWE-89: Improper Neutralization of Special Elements used in an SQL Command ('SQL Injection')",
         "security"
        ]
       }
      },
      {
       "id": "python.lang.security.audit.subprocess-shell-true",
       "name": "python.lang.security.audit.subprocess-shell-true",
       "defaultConfiguration": {
        "level": "warning"
       },
       "shortDescription": {
        "text": "subprocess call with shell=True"
       },
       "properties": {
        "tags": [
         "CWE-78: Improper Neutralization of Special Elements used in an OS Command ('OS Command Injection')",
         "security"
        ]
       }
      },
      {
       "id": "dockerfile.security.last-user-is-root",
       "name": "dockerfile.security.last-user-is-root",
       "defaultConfiguration": {
        "level": "error"
       },
       "shortDescription": {
        "text": "The last USER is root"
       },
       "properties": {
        "tags": [
         "CWE-250: Execution with Unnecessary Privileges",
         "security"
        ]
       }
      }
     ]
    }
   },
   "results": [
    {
     "ruleId": "rust.lang.security.sqli.formatted-sql-query",
     "message": {
      "text": "Axum handler builds a query from a path parameter."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "axum/src/main.rs",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 11,
         "startColumn": 5,
         "endLine": 11,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "rust.lang.security.sqli.formatted-sql-query",
     "message": {
      "text": "A route registration is flagged."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "axum/src/main.rs",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 7,
         "startColumn": 5,
         "endLine": 7,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "rust.lang.security.sqli.formatted-sql-query",
     "message": {
      "text": "A query is formatted from an argument."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "axum/src/db.rs",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 2,
         "startColumn": 5,
         "endLine": 2,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "rust.lang.security.sqli.formatted-sql-query",
     "message": {
      "text": "A statement is formatted from an argument."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "axum/src/db.rs",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 7,
         "startColumn": 5,
         "endLine": 7,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "java.lang.security.audit.formatted-sql-string",
     "message": {
      "text": "Spring handler concatenates a path variable into SQL."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "spring/src/main/java/com/acme/users/UserController.java",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 19,
         "startColumn": 5,
         "endLine": 19,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "python.lang.security.audit.subprocess-shell-true",
     "message": {
      "text": "subprocess call with shell=True."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "scripts/report.py",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 5,
         "startColumn": 5,
         "endLine": 5,
         "endColumn": 40
        }
       }
      }
     ]
    },
    {
     "ruleId": "dockerfile.security.last-user-is-root",
     "message": {
      "text": "The image runs as root."
     },
     "locations": [
      {
       "physicalLocation": {
        "artifactLocation": {
         "uri": "axum/Dockerfile",
         "uriBaseId": "%SRCROOT%"
        },
        "region": {
         "startLine": 2,
         "startColumn": 1,
         "endLine": 2,
         "endColumn": 10
        }
       }
      }
     ]
    },
    {
     "ruleId": "rust.lang.security.sqli.formatted-sql-query",
     "message": {
      "text": "A project-wide finding with no location."
     }
    }
   ]
  }
 ]
}
