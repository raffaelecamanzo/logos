{
  "version": "2.1.0",
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "runs": [
    {
      "tool": {
        "driver": {
          "informationUri": "https://github.com/google/osv-scanner",
          "name": "osv-scanner",
          "rules": [
            {
              "id": "PYSEC-2018-28",
              "name": "PYSEC-2018-28",
              "shortDescription": {
                "text": "PYSEC-2018-28: Requests sends an HTTP Authorization header to an http URI upon receiving a same-hostname https-to-http redirect"
              },
              "fullDescription": {
                "text": "Requests sends an HTTP Authorization header to an http URI upon receiving a same-hostname https-to-http redirect"
              },
              "deprecatedIds": [
                "PYSEC-2018-28"
              ],
              "help": {
