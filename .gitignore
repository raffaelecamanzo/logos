.worktrees/
notes/
.claude/scheduled_tasks.lock

# Logos self-analysis store (coordinator quality bracket snapshots on main).
# The dev harness runs the pinned `logos` against this repo; its store/DB and
# derived state are ephemeral and never committed. See the dogfooding plan.
.logos/

# Binary-generated, version-stamped wiki skill — materialized locally by
# `logos wiki skill --emit` / `init -i` (FR-WK-08), regenerable, never tracked
# (unlike the hand-authored dev-process skills in .agents/skills/).
.agents/skills/logos-wiki/

# Local-only agent/harness config — kept out of version control per
# working-directory preference (make them local to this checkout).
.agents/
.claude/

# Rust build artefacts
/target/
.playwright-mcp/

# The web UI's Playwright output, repeated from web/ui/.gitignore. A stop-gap
# (CR-208 item 9): `logos serve`'s watcher reads only this root file, so without
# these lines it indexes the harness build while a gate runs. CR-210 makes the
# watcher honour nested .gitignore files; these lines can go once it does.
/web/ui/e2e/.harness-dist/
/web/ui/e2e/.run/
/web/ui/e2e/.results/
/web/ui/test-results/
/web/ui/playwright-report/
/web/ui/blob-report/

# Local dev-tooling — kept out of the public release, retained on the maintainer's
# machine (project instructions, private-skills lockfile, RTK filter config).
/CLAUDE.md
/skills-lock.json
.rtk/
.swe-skills
/docs/specs
/docs/planning
/docs/requests
/.swe-skills

# Cobertura coverage reports
cobertura.xml

# macOS Finder metadata. Ignored not merely for tidiness: scripts/gate.sh
# derives its tree identity with `git add -A` (matching what the commit script
# commits), so an untracked .DS_Store appearing mid-gate changes that identity
# and invalidates the evidence the run just produced.
.DS_Store
