# Logos architecture contract (.logos/rules.toml) — checked-in policy
# enforced by `logos check` and the quality gate (FR-GV-01..05). Everything
# is optional: an omitted constraint is simply not enforced.
# Reference: docs/howto/configuration.md

# The values shown are the curated recommended baselines and the threshold
# defaults. Uncomment a key to enforce it; an omitted constraint is not enforced.
# [constraints]
# max_cycles = 0  # maximum allowed dependency cycles
# max_cc = 15  # maximum cyclomatic complexity per function
# max_fn_lines = 80  # maximum lines per function
# no_god_files = 40  # maximum symbols per file
# max_fan_in = 30  # max inbound dependency edges for any one symbol (FR-GV-11)
# max_fan_out = 30  # max outbound dependency edges for any one symbol (FR-GV-11)
# max_dead = 0  # max project-wide dead functions (FR-GV-11)
# max_duplicates = 0  # max project-wide duplicate functions (FR-GV-11)
# max_nesting_depth = 4  # max nesting depth per function (CR-005)
# max_brain_methods = 0  # max project-wide brain methods (CR-005)
# max_clone_ratio = 0.0  # max near-clone function ratio, 0.0-1.0 (CR-005)
# no_god_containers = true  # no class-like container over the god thresholds (CR-005)
#
# Ratchet adoption (FR-GV-23): a budget that names symbols may be declared
# as a table instead of a number, to tolerate today's offenders and fail only
# on new or worsened ones:
#   max_cc = { max = 15, ratchet = true }
# `logos check --bless` records today's offenders in .logos/rules-baseline.json.
# A blessed offender at or below its blessed value is a warning; a new or worse
# one is an error. `max_dead` and `max_cycles` also take the count form
# `{ baseline = N, delta = 0 }`.

# [metric_thresholds]
# nesting_depth = 4  # depth at which a function counts as deeply nested
# brain_complexity = 15  # complexity floor of a brain method
# brain_lines = 100  # line-count floor of a brain method
# brain_nesting = 3  # nesting floor of a brain method
# god_methods = 20  # method count at which a container is a god container
# god_span = 500  # line span at which a container is a god container
# clone_similarity = 0.85  # near-clone similarity threshold, (0, 1]
# clone_min_tokens = 50  # token floor below which a function is never a near clone
# duplicate_min_tokens = 50  # token floor a body needs to be an exact duplicate
# cohesion_min_classes = 5  # fewest scoreable classes Cohesion needs to apply

# Ordered layers: a higher `order` may not depend on a lower one. Files not
# matching any layer are exempt from layer ordering (DL-05).
# [[layers]]
# name  = "domain"
# paths = ["src/domain/**"]
# order = 0
#
# [[layers]]
# name  = "infrastructure"
# paths = ["src/infra/**"]
# order = 1

# Forbidden dependencies between named layers, reported with the reason.
# [[boundaries]]
# from   = "domain"
# to     = "infrastructure"
# reason = "the domain stays persistence-free"

# Glob-level import bans (FR-GV-12): any import/reference edge from a `from`-glob
# file into a `to`-glob file is a violation. Globs match file paths, not layer
# names. v1 covers resolved intra-workspace edges.
# [[forbidden_imports]]
# from   = "src/web/**"
# to     = "src/db/**"
# reason = "the web layer must not import the db directly"

# Git-history analytics tuning (CR-006, FR-GH-03..05). These keys tune the
# NON-GATED temporal tier only (`logos hotspots`) — they never affect `check`
# or the quality gate (BR-26). All optional; shown with their defaults.
# [history]
# window_months              = 12   # HEAD-anchored window length, in calendar months
# co_change_max_commit_files = 50   # commits touching more files are skipped for co-change pairing only
# defect_patterns            = ["(?i)\\bfix(es|ed)?\\b", "(?i)\\bbug\\b", "(?i)\\bhotfix\\b"]

# Coverage-ingestion tuning (CR-007, FR-CV-03/09). Tunes the NON-GATED advisory
# evidence tier only (`logos coverage`) — it never affects `check` or the quality
# gate (BR-28). `path_strip_prefixes` are stripped from coverage-report paths
# before they map to indexed files, so absolute build-dir paths bind.
# [coverage]
# path_strip_prefixes = ["/home/runner/work/myproject/", "/build/"]
